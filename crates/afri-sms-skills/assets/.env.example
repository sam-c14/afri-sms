# ==============================================================================
# afri-sms: Provider Credentials & Configuration
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your actual
# provider API keys and registered sender IDs.

# ------------------------------------------------------------------------------
# Sendar Configuration (https://sendar.io)
# ------------------------------------------------------------------------------
# Your Sendar Bearer API key.
SENDAR_API_KEY=your_sendar_api_key_here
# Approved alphanumeric sender ID / brand name (3-11 characters).
SENDAR_SENDER_ID=MyBrand
# Optional delivery route (e.g. "transactional" or "promotional").
# SENDAR_ROUTE=transactional
# Optional base URL override (used for local testing / wiremock).
# SENDAR_BASE_URL=https://api.sendar.io

# ------------------------------------------------------------------------------
# Termii Configuration (https://termii.com)
# ------------------------------------------------------------------------------
# Your Termii account API key (sent in request body).
TERMII_API_KEY=your_termii_api_key_here
# Registered and approved sender ID on your Termii dashboard.
TERMII_SENDER_ID=MyBrand
# Channel: "dnd" (bypasses Do Not Disturb lists in Nigeria) or "generic".
TERMII_CHANNEL=dnd
# Optional base URL override (used for local testing / wiremock).
# TERMII_BASE_URL=https://api.ng.termii.com

# ------------------------------------------------------------------------------
# Message Central Configuration (https://messagecentral.com)
# ------------------------------------------------------------------------------
# Your Message Central CPaaS authentication token (sent in authToken header).
MESSAGE_CENTRAL_AUTH_TOKEN=your_message_central_auth_token_here
# Approved sender ID or shortcode.
MESSAGE_CENTRAL_SENDER_ID=MyBrand
# Optional Message Central customer identifier.
# MESSAGE_CENTRAL_CUSTOMER_ID=your_customer_id_here
# Default country code fallback (e.g. "234" for Nigeria, "254" for Kenya, "233" for Ghana).
MESSAGE_CENTRAL_COUNTRY_CODE=234
# Optional base URL override (used for local testing / wiremock).
# MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com
